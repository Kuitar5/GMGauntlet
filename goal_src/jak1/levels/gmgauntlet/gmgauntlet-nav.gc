        (new 'static 'vector4ub :data (new 'static 'array uint8 4 #x3 #x5 #xe5 #xa0))
        (new 'static 'vector4ub :data (new 'static 'array uint8 4 #x80 #x35 #x50 #x80))
        (new 'static 'vector4ub :data (new 'static 'array uint8 4 #xe #xa #x50 #x3))
        (new 'static 'vector4ub :data (new 'static 'array uint8 4 #x5 #xe8 #xa0 #x5))
        (new 'static 'vector4ub :data (new 'static 'array uint8 4 #x35 #xa0 #x80 #xe))
        (new 'static 'vector4ub :data (new 'static 'array uint8 4 #x50 #x50 #x3 #xa))
        (new 'static 'vector4ub :data (new 'static 'array uint8 4 #xe8 #x0 #x0 #x0)))))
(unless (custom-nav<-name 'gmgauntlet-circle)
  (set! *custom-nav-list* (cons '(gmgauntlet-circle *nav-gmgauntlet-circle*) *custom-nav-list*)))

