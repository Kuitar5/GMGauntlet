;;-*-Lisp-*-
(in-package goal)
;; lt-task-trigger.gc -- shared code of OpenGOAL Level Tools (written by the addon).
;; lt-task-trigger: a trigger volume's task actions. When Jak enters its convex
;; volume it closes / opens task stages ('actions: task, status, 0 close / 1 open
;; per action), once per entry. Compiled once (game.gp), loaded with the game.

(deftype lt-task-trigger (process-drawable)
  ((cull-radius float)
   (inside      symbol)
   (num-planes  int32)
   (planes      (inline-array vector))
   (num-actions int32)
   (actions     (pointer int32)))
  :heap-base #x70
  (:states lt-task-trigger-active))

(defstate lt-task-trigger-active (lt-task-trigger)
  :code
  (behavior ()
    (loop
      (when (and *target* (zero? (mod (-> *display* base-frame-counter) 4)))
        (let* ((pos (-> *target* control trans))
               (dx  (- (-> pos x) (-> self root trans x)))
               (dy  (- (-> pos y) (-> self root trans y)))
               (dz  (- (-> pos z) (-> self root trans z)))
               (cr  (-> self cull-radius))
               (inside (and (< (+ (* dx dx) (* dy dy) (* dz dz)) (* cr cr))
                            (lt-point-in-planes? (-> self planes) (-> self num-planes) pos))))
          (when (and inside (not (-> self inside)))
            (dotimes (i (-> self num-actions))
              (let ((task   (the-as game-task (-> self actions (* i 3))))
                    (status (the-as task-status (-> self actions (+ (* i 3) 1)))))
                (if (zero? (-> self actions (+ (* i 3) 2)))
                  (close-specific-task! task status)
                  (open-specific-task! task status)))))
          (set! (-> self inside) inside)))
      (suspend))))

(defmethod init-from-entity! ((this lt-task-trigger) (arg0 entity-actor))
  (set! (-> this root) (new (quote process) (quote trsqv)))
  (process-drawable-from-entity! this arg0)
  (set! (-> this inside) #f)
  (set! (-> this cull-radius) (res-lump-float arg0 (quote cull-radius) :default 122880.0))
  (let ((tag (new (quote static) (quote res-tag))))
    (let ((data (res-lump-data arg0 (quote vol) (inline-array vector) :tag-ptr (& tag))))
      (set! (-> this planes) (the-as (inline-array vector) data))
      (set! (-> this num-planes) (if data (the-as int (-> tag elt-count)) 0))))
  (let ((tag (new (quote static) (quote res-tag))))
    (let ((data (res-lump-data arg0 (quote actions) (pointer int32) :tag-ptr (& tag))))
      (set! (-> this actions) data)
      (set! (-> this num-actions) (if data (/ (the-as int (-> tag elt-count)) 3) 0))))
  (go lt-task-trigger-active)
  (none))
